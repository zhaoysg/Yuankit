    "entry": "blocks/settings-panel/index.js",
    "styles": [
      "blocks/style.css"
    ],
    "events": {
      "save": "{name:string,email:string,role:string,notifications:boolean}"
    },
    "dependencies": [
      "YkCard",
      "YkInput",
