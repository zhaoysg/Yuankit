    "persistence": "none; caller handles save event"
  },
  {
    "id": "content-card",
    "name": "ContentCard",
    "title": "内容卡片",
    "entry": "blocks/content-card/index.js",
    "styles": [
      "blocks/style.css"
    ],
    "props": [
      "title",
      "excerpt",
      "author"
    ],
    "events": {
      "open": "void"
    },
    "dependencies": [
      "YkCard",
      "YkBadge",
