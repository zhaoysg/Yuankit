{
  "version": "0.4.0",
  "base": {
    "font": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans CJK SC', 'Microsoft YaHei', sans-serif",
    "font-size": "14px",
    "line-height": "1.55",
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-6": "24px",
    "space-8": "32px",
    "duration": "160ms",
    "ease": "cubic-bezier(.2,.7,.2,1)",
    "focus-width": "3px",
    "overlay": "rgb(16 19 28 / .5)",
    "radius-pill": "999px",
    "z-tooltip": "1000"
  },
  "modes": {
    "light": {
      "primary": "#5b45d6",
      "primary-hover": "#4934b9",
      "on-primary": "#ffffff",
      "primary-soft": "#f0edff",
      "background": "#f7f8fa",
      "surface": "#ffffff",
      "surface-raised": "#ffffff",
      "muted": "#f1f2f6",
      "text": "#20232d",
      "text-muted": "#626875",
      "border": "#d9dce4",
      "success": "#16714d",
      "success-soft": "#e9f6ef",
      "warning": "#875711",
      "warning-soft": "#fff4de",
      "danger": "#b82f4e",
      "danger-soft": "#fff0f3",
      "focus": "#826bee"
    },
    "dark": {
      "primary": "#a99afb",
      "primary-hover": "#c3b8ff",
      "on-primary": "#1c1637",
      "primary-soft": "#30264f",
      "background": "#14161d",
      "surface": "#1c1f29",
      "surface-raised": "#242835",
      "muted": "#292d3a",
      "text": "#f1f2f7",
      "text-muted": "#b0b5c5",
      "border": "#444a5e",
      "success": "#8edab2",
      "success-soft": "#193c30",
      "warning": "#ebc880",
      "warning-soft": "#433720",
      "danger": "#f69bb0",
      "danger-soft": "#452a36",
      "focus": "#baaaff"
    }
  },
  "skins": {
    "soft": {
      "radius-control": "12px",
      "radius-panel": "20px",
      "shadow": "0 8px 30px rgb(25 26 45 / .055)",
      "field-background": "var(--yk-muted)"
    },
    "precise": {
      "radius-control": "6px",
      "radius-panel": "10px",
      "shadow": "0 2px 8px rgb(25 26 45 / .035)",
      "field-background": "var(--yk-surface)"
    }
  },
  "densities": {
    "comfortable": {
      "height-sm": "32px",
      "height-md": "40px",
      "height-lg": "48px",
      "control-padding": "14px",
      "panel-padding": "24px"
    },
    "compact": {
      "height-sm": "28px",
      "height-md": "32px",
      "height-lg": "40px",
      "control-padding": "10px",
      "panel-padding": "16px"
    }
  }
}
